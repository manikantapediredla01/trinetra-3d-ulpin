# =============================================================================
# TRINETRA — 3D ULPIN & Vertical Property Intelligence Platform
# Environment Variables Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES
# DO NOT COMMIT .env TO VERSION CONTROL
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=TRINETRA
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra
POSTGRES_USER=trinetra
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://trinetra:CHANGE_THIS_DB_PASSWORD@localhost:5432/trinetra
DATABASE_URL_SYNC=postgresql://trinetra:CHANGE_THIS_DB_PASSWORD@localhost:5432/trinetra

# --- Redis (optional — used for background task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Tokens ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=las,laz,geojson,json,zip,gpkg,pdf,tif,tiff,png,jpg,jpeg,csv,osm

# --- CesiumJS ---
# Get a free token at https://ion.cesium.com/signup
CESIUM_ION_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJub25jZSI6IklwNTBxRkhCdjBlMUNKYUUiLCJqdGkiOiI5MmM4NmE5YS1kMTI3LTRkODktOGQyYi1lZGZmNDRkY2MyMjgiLCJpZCI6NDgyNTExLCJzdWIiOiJtYW5pa2FudGFwZWRpcmVkbGEwMCIsImlzcyI6Imh0dHBzOi8vYXBpLmNlc2l1bS5jb20iLCJhdWQiOiJUUklORVRSQSBEZXZlbG9wbWVudCIsImlhdCI6MTc4ODc3MjIwN30.NI3JNOLZCbZq6CxlgstbwjwwlEYgyT3NL1VZseQPHpg

# --- Demo / Seeded Accounts (DEMO ENVIRONMENT ONLY) ---
# Passwords for seeded demo accounts. Change in any production deployment.
DEMO_ADMIN_PASSWORD=Trinetra@Admin2024
DEMO_LAND_AUTHORITY_PASSWORD=Trinetra@LandAuth2024
DEMO_GIS_OFFICER_PASSWORD=Trinetra@GIS2024
DEMO_URBAN_PLANNER_PASSWORD=Trinetra@Urban2024
DEMO_REVIEW_OFFICER_PASSWORD=Trinetra@Review2024
DEMO_CITIZEN_PASSWORD=Trinetra@Citizen2024

# --- Quantum (Qiskit Aer Simulator) ---
QAOA_BACKEND=aer_simulator
QAOA_MAX_QUBITS=10
QAOA_DEFAULT_P=1
QAOA_MAX_SHOTS=1024

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN_HERE
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
